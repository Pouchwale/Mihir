# ---------- Mode ----------
# dev  = WATI mocked, dummy fixtures, dev banner in dashboard
# prod = real WATI, real orders source, no banner
APP_MODE=dev

# ---------- Database ----------
# Paste the URL your host gives you - postgres://, postgresql:// and mysql:// are all accepted and
# converted to the async driver automatically, and ?sslmode= is handled for you.
#   PostgreSQL (Render, Heroku, Supabase): postgresql://user:pass@host/dbname
#   MySQL:                                 mysql://user:pass@host:3306/order_bot
#   SQLite (local development only):       sqlite+aiosqlite:///./order_bot.db
#
# WARNING on Render, Heroku, Cloud Run and similar: the filesystem is wiped on every deploy, so
# SQLite there loses your customers, chat log and edited messages each time you deploy. Use the
# host's managed database instead. The Go live page flags this.
DATABASE_URL=sqlite+aiosqlite:///./order_bot.db

# ---------- Admin ----------
# In APP_MODE=prod the server REFUSES TO START while any of the four values marked (go-live) below
# is still an example. Open the dashboard's "Go live" page to see exactly what is missing.
ADMIN_KEY=change-me-admin-key
# Encrypts the connection passwords saved from the dashboard. Any phrase works, it just has to stay
# the same. Leave empty and one is generated into backend/.secret_key - but on a host with a
# throwaway filesystem (Render and friends) that file is recreated on every deploy and the saved
# passwords silently stop working, so set this explicitly there.
SECRET_KEY=
# (go-live) Printed to customers in the "contact us" and "could not verify" messages.
SUPPORT_CONTACT=+91-XXXXXXXXXX / support@example.com
# Emergency override for the start-up check. Never set this on a real server.
ALLOW_INSECURE_PROD=false

# ---------- Public address ----------
# (go-live) The https address customers' messages arrive on, e.g. https://bot.yourdomain.com
# Behind a reverse proxy or a tunnel the server cannot work this out by itself, and a wrong guess
# means the webhook address given to WATI is wrong. Leave empty only for local development.
PUBLIC_BASE_URL=

# ---------- WATI ----------
# Scopes to tick when you create the token (Connector -> API -> Create API Token). WATI does not
# publish a full scope list, so match these to whatever the picker offers - the bot calls:
#   POST /api/v1/sendSessionMessage/{number}        every text reply            <- required
#   POST /api/v1/sendInteractiveButtonsMessage      button menus                <- required
#   POST /api/v1/sendInteractiveListMessage         list menus                  <- required
#   GET|POST /api/v2/webhookEndpoints               register the webhook        <- required if you have no WATI dashboard
#   GET  /api/v1/getContacts                        connection test only        <- optional
#   GET  /api/v1/getMedia                           voice notes                 <- only if VOICE_NOTES=true
# If in doubt tick everything: the token stays on this server and never reaches a browser.
# Both values come from WATI -> Settings -> API Docs.
# (go-live) The last part of the URL is YOUR tenant id, e.g. https://live-mt-server.wati.io/123456
# Leaving <tenantId> in place keeps the bot in simulation mode, and blocks a prod start.
WATI_BASE_URL=https://live-mt-server.wati.io/<tenantId>
# (go-live) The long token starting eyJ... Empty = outgoing messages are simulated.
WATI_TOKEN=
# (go-live) A long random secret YOU choose - 32 to 64 characters. This is the ONLY WATI value you
# invent: there is nothing to look up in the WATI portal, and the eyJ... token from WATI belongs in
# WATI_TOKEN above, not here. WATI sends it back on every call so the bot can tell a real WATI
# request from anyone else who finds the address. Then add this in WATI -> Settings -> Webhooks for
# the event "Message received":   https://<your-domain>/webhook/wati?token=<WATI_WEBHOOK_TOKEN>
# Changing the secret changes that address, so register the webhook again afterwards.
WATI_WEBHOOK_TOKEN=change-me-webhook-token
# Force dry run even with a token (true/false). Empty = auto.
WATI_DRY_RUN=
# Interactive list/button endpoints: v1 (default, /api/v1/sendInteractive*Message?whatsappNumber=) or v3 (/api/ext/v3/conversations/messages/interactive)
WATI_API_VERSION=v1

# ---------- AI (optional) ----------
# Voice notes are OFF by default: speech-to-text can misread digits, and looking up the wrong order
# is worse than asking the customer to type. Turn on here (or in Settings -> Conversation) once
# GROQ_API_KEY is set; without a key a voice note gets the editable "please type" reply.
VOICE_NOTES=false
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional. Buttons, order numbers and item codes all work without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Customers (SAP Excel export) ----------
# NOTE: everything in this section and the next can also be set in the dashboard
# (Data -> Customer Excel / Order data). Saved values there win over this file.
# local = folder or network share | dropbox | url
CUSTOMERS_SOURCE=local
CUSTOMERS_URL=
CUSTOMERS_URL_KEY=
CUSTOMERS_URL_KEY_IN=header
CUSTOMERS_URL_KEY_NAME=X-API-Key
CUSTOMERS_SHEET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_FILE_PATH=/SAP/customers.xlsx
CUSTOMERS_FILE_PATH=fixtures/customers_dummy.xlsx
CUSTOMERS_COL_CODE=Customer Code
CUSTOMERS_COL_NAME=Customer Name
CUSTOMERS_COL_CONTACT=Contact
# cron: minute hour day month weekday  (default 06:10 every day)
CUSTOMER_SYNC_CRON=10 6 * * *

# ---------- Orders source (external API: endpoint + key, table in any format) ----------
# file | http | sql
ORDERS_SOURCE=file
ORDERS_FILE_PATH=fixtures/orders_dummy.json
# http
ORDERS_API_URL=
ORDERS_API_METHOD=GET
ORDERS_API_KEY=
# header | query | bearer
ORDERS_API_KEY_IN=header
ORDERS_API_KEY_NAME=X-API-Key
ORDERS_API_BODY=
# auto | json | csv | xlsx | html
ORDERS_FORMAT=auto
ORDERS_SHEET=
# sql
ORDERS_SQL_URL=
ORDERS_SQL_QUERY=
# Column map: internal field -> header in the source table
ORDERS_COLUMN_MAP={"so_no":"SO No","po_no":"PO No","fg_item_code":"FG Item Code","customer_name":"Customer Name","connection_status":"Connection Status","real_status":"Real Status (PPC)"}
ORDER_REFRESH_MINUTES=5
ORDERS_STALE_MINUTES=30

# ---------- Session / limits ----------
# After this much silence the customer gets the greeting and the language question again.
SESSION_TIMEOUT_MIN=30
# How SO / item choices are shown: auto = buttons when 3 or fewer, list otherwise | list = always a list
SO_MENU_STYLE=auto
FG_MAX_ATTEMPTS=2
RATE_LIMIT_MSGS=20
RATE_LIMIT_WINDOW_MIN=10
# One customer message may never block the queue for longer than this.
QUEUE_ITEM_TIMEOUT_SEC=90
# Flood protection on the public webhook, per calling IP per 10 seconds.
WEBHOOK_MAX_PER_10S=120

# ---------- Logs ----------
# Empty = stdout only. Set a path for a rotating log file (useful for the Windows service).
LOG_FILE=
LOG_MAX_MB=20
LOG_BACKUPS=5

# ---------- Alerts ----------
ALERT_SLACK_WEBHOOK=
