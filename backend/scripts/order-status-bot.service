# Linux alternative (systemd). Copy to /etc/systemd/system/order-status-bot.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now order-status-bot
[Unit]
Description=WhatsApp Order Status Bot (WATI -> backend)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/order-status-bot/backend
EnvironmentFile=/opt/order-status-bot/backend/.env
# --workers 1: the message queue worker and the scheduled jobs run inside the web process, so a
# second worker would import customers twice and race for queued messages.
ExecStart=/opt/order-status-bot/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=3
User=orderbot
# Basic sandboxing: the bot only needs its own directory and the network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
